#include <stdio.h>

int add(int a, int b) {
    return a + b;
}

int main() {
    
    int (*opPtr)(int, int);
    

    opPtr = &add; // You can also just write: opPtr = add;
    

    int result = opPtr(10, 5);
    
    printf("Result of addition via pointer: %d\n", result);
    
    return 0;
}
