#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int r, c;
    if (scanf("%d %d", &r, &c) != 2) return 0;

    int matrix[r][c];

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    
    for (int j = 0; j < c; j++) {
        for (int i = 0; i < r; i++) {
            printf("%d", matrix[i][j]);
            if (i < r - 1) {
                printf(" ");
            }
        }
        printf("\n");
    }

    return 0;
}
