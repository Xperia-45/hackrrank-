#include <stdio.h>


long long reverseDigits(long long n) {
    long long reversed = 0;
    while (n > 0) {
        reversed = reversed * 10 + (n % 10);
        n /= 10;
    }
    return reversed;
}

int main() {
    long long n;
    if (scanf("%lld", &n) == 1) {
        printf("%lld\n", reverseDigits(n));
    }
    return 0;
}
