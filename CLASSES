#include <iostream>
#include <string>

using namespace std;

// 1. Define the Class
class Car {
// 'public' means these attributes and methods can be accessed outside the class
public: 
    // Attributes (Variables)
    string brand;
    string model;
    int year;

    // Constructor (A special function that initializes objects automatically)
    Car(string carBrand, string carModel, int carYear) {
        brand = carBrand;
        model = carModel;
        year = carYear;
    }

    // Method (Function inside the class)
    void displayInfo() {
        cout << "Car Details: " << year << " " << brand << " " << model << endl;
    }
};

// 2. Main Function to run the program
int main() {
    // Creating Objects (instances) of the Car class using the constructor
    Car carObj1("Toyota", "Corolla", 2022);
    Car carObj2("Tesla", "Model 3", 2025);

    // Calling the method using the dot (.) operator to display information
    carObj1.displayInfo();
    carObj2.displayInfo();

    return 0;
}
