#include <iostream>
#include <string>

using namespace std;
class Car {
public: 
    string brand;
    string model;
    int year;


    Car(string carBrand, string carModel, int carYear) {
        brand = carBrand;
        model = carModel;
        year = carYear;
    }

    
    void displayInfo() {
        cout << "Car Details: " << year << " " << brand << " " << model << endl;
    }
};

int main() {
    
    Car carObj1("Toyota", "Corolla", 2022);
    Car carObj2("Tesla", "Model 3", 2025);

    carObj1.displayInfo();
    carObj2.displayInfo();

    return 0;
}
