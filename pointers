#include <stdio.h>
#include <stdlib.h>
void update(int *a , int *b)
{
int sum = *a+*b;
int dif = abs (*a -* b) ;
*a = sum ;
*b = dif ;
}
int main()
{
int a,b;
scanf("%d %d" , &a,&b) ;
update(&a ,&b);
printf("%d\n%d",a,b);
return 0;
}
#THIS IS ANOTHER PROGRAM USING POINTER
#include <stdio.h>

int main() {
    int n;
    if (scanf("%d", &n) == 1) {
        int arr[n];
        
        for (int i = 0; i < n; i++) {
            scanf("%d", &arr[i]);
        }
        

        int *ptr = arr;
  
        for (int i = 0; i < n; i++) {
            if (i == 0) {
                printf("%d", *(ptr + i));
            } else {
                printf(" %d", *(ptr + i));
            }
        }
        printf("\n");
    }
    return 0;
}
