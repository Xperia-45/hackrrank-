#include <stdio.h>

int main() {
    int a, b;
    if (scanf("%d %d", &a, &b) == 2) {
        int *ptr1 = &a;
        int *ptr2 = &b;

        if (ptr1 == ptr2) {
            printf("Pointers are equal\n");
        } else {
            printf("Pointers are not equal\n");
        }
    }
    return 0;
}
